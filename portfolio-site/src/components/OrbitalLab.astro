---
const examples = [
  { label: 'Hello, world', code: 'tandika(“Muli bwanji?”)\nsonya(“TongaLang is ready.”)', output: 'Muli bwanji?\nTongaLang is ready.' },
  { label: 'A small calculation', code: 'ika x = 12\nika y = 8\nsonya(x + y)', output: '20' },
  { label: 'A condition', code: 'ika level = 82\nsaka (level > 70) {\n  sonya(“Tank is healthy”)\n}', output: 'Tank is healthy' },
];
---
<section class="orbital-lab section-shell" id="orbital-lab" data-scene="interactive-lab">
  <div class="section-heading" data-motion>
    <p class="eyebrow">05 · Interactive systems lab</p>
    <h2>Not just screenshots.<br/><em>Try the thinking.</em></h2>
    <p>Small, self-contained demonstrations inspired by the projects. These are illustrative simulations—not live customer systems or production integrations.</p>
  </div>

  <div class="lab-grid" data-motion>
    <article class="lab-panel lab-panel--editor" data-lab="tongalang">
      <header class="lab-panel-head">
        <div><span class="lab-kicker">01 / LANGUAGE DESIGN</span><h3>TongaLang playground</h3></div>
        <span class="lab-state"><i></i> SIMULATED</span>
      </header>
      <p class="lab-description">Explore a tiny, prewritten TongaLang-inspired example and see its illustrative output.</p>
      <div class="editor-toolbar"><span>example.tg</span><label for="tongalang-example">Choose example</label><select id="tongalang-example">{examples.map((example, index) => <option value={index}>{example.label}</option>)}</select></div>
      <pre class="lab-code" aria-label="Example source code"><code data-tg-code>{examples[0].code}</code></pre>
      <div class="lab-actions"><button class="lab-button" type="button" data-tg-run><i class="ph ph-play" aria-hidden="true"></i> Run example</button><span>Safe demo · no code execution</span></div>
      <div class="lab-output" aria-live="polite"><span>OUTPUT</span><pre data-tg-output>Ready when you are.</pre></div>
    </article>

    <article class="lab-panel lab-panel--water" data-lab="smartwater">
      <header class="lab-panel-head">
        <div><span class="lab-kicker">02 / IOT TELEMETRY</span><h3>SmartWater monitor</h3></div>
        <span class="lab-state"><i></i> SIMULATED</span>
      </header>
      <p class="lab-description">Move the level control to explore how a tank monitor can communicate changing conditions.</p>
      <div class="tank-stage">
        <div class="tank-visual" role="img" aria-label="Illustrative water tank level"><div class="tank-water" data-tank-water style="height:72%"></div><span class="tank-mark tank-mark--high">100%</span><span class="tank-mark tank-mark--mid">50%</span><span class="tank-mark tank-mark--low">0%</span></div>
        <div class="tank-reading"><strong data-tank-value>72%</strong><span>ESTIMATED LEVEL</span><b data-tank-status>Healthy range</b></div>
      </div>
      <label class="tank-control" for="tank-level"><span>Adjust simulated level</span><output data-tank-output>72%</output></label>
      <input id="tank-level" type="range" min="0" max="100" value="72" step="1" data-tank-slider />
      <div class="tank-scale"><span>Empty</span><span>Full</span></div>
      <p class="lab-footnote">Demo values only · no sensor or backend connection</p>
    </article>

    <article class="lab-panel lab-panel--ops" data-lab="subtrack">
      <header class="lab-panel-head">
        <div><span class="lab-kicker">03 / SERVICE OPERATIONS</span><h3>SubTrack overview</h3></div>
        <span class="lab-state"><i></i> SAMPLE DATA</span>
      </header>
      <p class="lab-description">A compact look at the kind of operational picture a subscription service dashboard can provide.</p>
      <div class="ops-summary">
        <div><span>ACTIVE PLANS</span><strong>37</strong><small>Illustrative count</small></div>
        <div><span>MONTHLY REVENUE</span><strong>K 18,500</strong><small>Sample figure</small></div>
      </div>
      <div class="ops-list" aria-label="Sample subscriber statuses">
        <div><span class="ops-avatar">JM</span><span class="ops-person"><b>Customer A</b><small>Home connection</small></span><span class="ops-pill ops-pill--good">Active</span></div>
        <div><span class="ops-avatar">BK</span><span class="ops-person"><b>Customer B</b><small>Business connection</small></span><span class="ops-pill ops-pill--warn">Due soon</span></div>
        <div><span class="ops-avatar">TM</span><span class="ops-person"><b>Customer C</b><small>Home connection</small></span><span class="ops-pill ops-pill--good">Active</span></div>
      </div>
      <p class="lab-footnote">Fictional customer labels and sample values · no personal data</p>
    </article>
  </div>
</section>

<script>
  function initializeOrbitalLab() {
    const lab = document.querySelector('.orbital-lab');
  if (lab && !lab.hasAttribute('data-lab-ready')) {
    lab.setAttribute('data-lab-ready', 'true');
    const examples = [
      { code: 'tandika(“Muli bwanji?”)\nsonya(“TongaLang is ready.”)', output: 'Muli bwanji?\nTongaLang is ready.' },
      { code: 'ika x = 12\nika y = 8\nsonya(x + y)', output: '20' },
      { code: 'ika level = 82\nsaka (level > 70) {\n  sonya(“Tank is healthy”)\n}', output: 'Tank is healthy' },
    ];
    const selector = lab.querySelector<HTMLSelectElement>('#tongalang-example');
    const code = lab.querySelector<HTMLElement>('[data-tg-code]');
    const output = lab.querySelector<HTMLElement>('[data-tg-output]');
    const run = lab.querySelector<HTMLButtonElement>('[data-tg-run]');
    const renderExample = () => {
      const example = examples[Number(selector.value)] ?? examples[0];
      code.textContent = example.code;
      output.textContent = 'Ready when you are.';
    };
    selector?.addEventListener('change', renderExample);
    run?.addEventListener('click', () => {
      const example = examples[Number(selector?.value)] ?? examples[0];
      output.textContent = example.output;
      run.innerHTML = '<i class="ph ph-check" aria-hidden="true"></i> Example complete';
    });
    const slider = lab.querySelector<HTMLInputElement>('[data-tank-slider]');
    const water = lab.querySelector<HTMLElement>('[data-tank-water]');
    const value = lab.querySelector<HTMLElement>('[data-tank-value]');
    const valueOutput = lab.querySelector<HTMLOutputElement>('[data-tank-output]');
    const status = lab.querySelector<HTMLElement>('[data-tank-status]');
    slider?.addEventListener('input', () => {
      const level = Number(slider.value);
      water.style.height = level + '%';
      value.textContent = level + '%';
      valueOutput.textContent = level + '%';
      status.textContent = level < 20 ? 'Critical · refill needed' : level < 40 ? 'Low · monitor closely' : level > 90 ? 'Near capacity' : 'Healthy range';
      status.dataset.state = level < 20 ? 'critical' : level < 40 ? 'low' : level > 90 ? 'high' : 'healthy';
    });
    }
  }
  document.addEventListener('astro:page-load', initializeOrbitalLab);
  initializeOrbitalLab();
</script>

<style>
  .orbital-lab { padding-block: var(--section-y); }
  .orbital-lab .section-heading { margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .lab-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .lab-panel { min-width:0; padding:clamp(1.1rem,2.5vw,1.7rem); border:1px solid var(--line); border-radius:var(--radius-lg); background:linear-gradient(145deg,rgb(255 255 255 / 4%),transparent 48%),rgb(13 16 19 / 84%); box-shadow:var(--shadow-lift); }
  .lab-panel--editor { grid-row:span 2; }
  .lab-panel-head { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; margin-bottom:1rem; }
  .lab-kicker,.lab-state,.editor-toolbar,.lab-output>span,.ops-summary>div>span { font: .62rem/1.5 var(--mono); letter-spacing:.12em; color:var(--muted); }
  .lab-panel h3 { margin-top:.45rem; font:600 clamp(1.4rem,2.4vw,2rem)/1.05 var(--serif); }
  .lab-state { display:inline-flex; align-items:center; gap:.4rem; padding:.35rem .55rem; border:1px solid var(--line); border-radius:99px; white-space:nowrap; }
  .lab-state i { width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent); }
  .lab-description { max-width:48ch; margin:0 0 1.25rem; color:var(--muted); font-size:.88rem; }
  .editor-toolbar { display:flex; flex-wrap:wrap; align-items:center; gap:.7rem; padding:.65rem .8rem; border:1px solid var(--line-soft); border-bottom:0; border-radius:12px 12px 0 0; background:#101316; }
  .editor-toolbar label { margin-left:auto; }
  .editor-toolbar select { max-width:48%; border:1px solid var(--line); border-radius:7px; background:#171b1e; padding:.3rem .45rem; font-size:.75rem; }
  .lab-code { min-height:164px; margin:0; padding:1rem; overflow:auto; border:1px solid var(--line-soft); border-radius:0 0 12px 12px; background:#090b0d; color:#d9e4d2; font: .82rem/1.9 var(--mono); white-space:pre-wrap; }
  .lab-actions { display:flex; align-items:center; flex-wrap:wrap; gap:.8rem; margin:1rem 0; }
  .lab-button { display:inline-flex; align-items:center; gap:.5rem; border:1px solid var(--accent-line); border-radius:99px; padding:.65rem 1rem; background:var(--accent); color:var(--accent-ink); font-weight:700; font-size:.8rem; }
  .lab-actions>span,.lab-footnote { color:var(--muted); font-size:.7rem; }
  .lab-output { padding:.8rem 1rem; border:1px solid var(--line-soft); border-radius:12px; background:#080a0b; }
  .lab-output pre { margin:.45rem 0 0; color:var(--accent); font: .8rem/1.7 var(--mono); white-space:pre-wrap; }
  .tank-stage { display:flex; align-items:center; justify-content:center; gap:2rem; min-height:190px; padding:1rem; border:1px solid var(--line-soft); border-radius:14px; background:radial-gradient(circle at 25% 70%,rgb(85 190 255 / 10%),transparent 50%),#0a1013; }
  .tank-visual { position:relative; width:92px; height:150px; overflow:hidden; border:2px solid #738b91; border-radius:12px 12px 18px 18px; background:linear-gradient(90deg,#111c20,#17282d); }
  .tank-water { position:absolute; inset:auto 0 0; background:linear-gradient(180deg,#69d9f4,#1786bd); transition:height .25s ease; box-shadow:0 -4px 18px rgb(73 203 255 / 28%); }
  .tank-mark { position:absolute; right:5px; color:#fff; font: .55rem var(--mono); text-shadow:0 1px 3px #000; }
  .tank-mark--high { top:5px; }.tank-mark--mid { top:48%; }.tank-mark--low { bottom:5px; }
  .tank-reading { display:grid; gap:.35rem; }
  .tank-reading strong { font:700 clamp(2rem,4vw,3rem)/1 var(--sans); letter-spacing:-.06em; }
  .tank-reading span { color:var(--muted); font: .6rem var(--mono); letter-spacing:.1em; }
  .tank-reading b { color:var(--accent); font-size:.78rem; }
  .tank-reading b[data-state="critical"],.tank-reading b[data-state="low"] { color:#ff9a6b; }
  .tank-control { display:flex; justify-content:space-between; margin:1rem 0 .5rem; font-size:.8rem; }
  .tank-control output { color:var(--accent); font-family:var(--mono); }
  [data-tank-slider] { width:100%; accent-color:var(--accent); }
  .tank-scale { display:flex; justify-content:space-between; color:var(--muted); font: .62rem var(--mono); }
  .ops-summary { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; margin-bottom:1rem; }
  .ops-summary>div { display:grid; gap:.25rem; padding:1rem; border:1px solid var(--line-soft); border-radius:12px; background:#0c1012; }
  .ops-summary strong { font:600 clamp(1.35rem,2.5vw,2rem)/1 var(--sans); letter-spacing:-.04em; }
  .ops-summary small { color:var(--muted); font-size:.68rem; }
  .ops-list { display:grid; gap:.15rem; }
  .ops-list>div { display:flex; align-items:center; gap:.7rem; padding:.75rem .25rem; border-bottom:1px solid var(--line-soft); }
  .ops-avatar { display:grid; place-items:center; width:34px;height:34px;border:1px solid var(--line);border-radius:50%;background:rgb(var(--accent-rgb)/10%);color:var(--accent);font: .65rem var(--mono); }
  .ops-person { display:grid; gap:.1rem; flex:1; }
  .ops-person b { font-size:.8rem; font-weight:600; }.ops-person small { color:var(--muted); font-size:.68rem; }
  .ops-pill { padding:.25rem .5rem; border-radius:99px; font: .62rem var(--mono); }
  .ops-pill--good { color:var(--accent); background:rgb(var(--accent-rgb)/10%); }.ops-pill--warn { color:#ffbf78;background:rgb(255 191 120 / 10%); }
  @media(max-width:760px) { .lab-grid { grid-template-columns:1fr; }.lab-panel--editor { grid-row:auto; }.tank-stage { justify-content:flex-start; gap:1.4rem; } }
  @media(prefers-reduced-motion:reduce) { .tank-water { transition:none; } }
</style>
