---
import { heroProgramLines as program, heroWords as words } from '../data/hero-lab';
---

<section class="hero-lab" data-hero-lab aria-labelledby="hero-lab-title">
  <div class="lab-words">
    <p class="eyebrow" id="hero-lab-title">Tonga words, real Python</p>
    <p class="lab-lede">
      TongaLang was my final-year project at CBU. The words are borrowed from Tonga,
      and underneath it is a Python lexer, parser and interpreter. Pick a word to see
      where it lands, then run the program for real.
    </p>
    <ul class="lab-keys" aria-label="TongaLang keywords">
      {words.map((entry) => (
        <li>
          <button type="button" data-lab-word={entry.word} data-lab-lines={entry.lines.join(',')} data-lab-note={entry.note}>
            <code>{entry.word}</code>
            <small>{entry.gloss}</small>
          </button>
        </li>
      ))}
    </ul>
    <p class="lab-meaning" data-lab-meaning aria-live="polite" data-lab-default="Choose a word to see where it lands in the program. Escape clears the highlight.">
      Choose a word to see where it lands in the program. Escape clears the highlight.
    </p>
  </div>

  <figure class="lab-code">
    <figcaption>
      <span>main.tg</span>
      <span>6 lines · the real thing</span>
    </figcaption>
    <pre><code>{program.map((line, index) => (
      <span data-lab-line={index}>{line}</span>
    ))}</code></pre>
  </figure>

  <div class="lab-run">
    <div class="lab-actions">
      <button type="button" class="button" data-lab-run>Run the interpreter <span aria-hidden="true">↗</span></button>
      <button type="button" class="lab-stop" data-lab-stop hidden>Stop</button>
    </div>
    <pre class="lab-output" data-lab-output role="status" aria-live="polite">Output appears here after a run.</pre>
    <p class="lab-status" data-lab-status>Nothing downloads until you press run.</p>
    <p class="lab-foot">
      <a class="text-link" href="/playground/">Open the full playground <span aria-hidden="true">↗</span></a>
      <span data-lab-time></span>
    </p>
  </div>
</section>

<style>
  .hero-lab {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr) minmax(0, 1fr);
    border: 1px solid var(--line);
    border-radius: 5px;
    background: linear-gradient(180deg, rgb(16 28 48 / 92%), rgb(8 14 28 / 96%));
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .lab-words,
  .lab-code,
  .lab-run {
    min-width: 0;
    padding: 1.4rem 1.5rem;
  }
  .lab-words {
    border-right: 1px solid var(--line-soft);
  }
  .lab-code {
    margin: 0;
    border-right: 1px solid var(--line-soft);
    display: flex;
    flex-direction: column;
  }
  .lab-lede {
    color: var(--text-dim);
    font-size: 0.86rem;
    max-width: 42ch;
    margin: 0.7rem 0 1.1rem;
  }
  .lab-keys {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    padding: 0;
  }
  .lab-keys button {
    display: grid;
    gap: 0.1rem;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: transparent;
    color: var(--text);
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .lab-keys button:hover,
  .lab-keys button:focus-visible {
    border-color: var(--accent);
  }
  .lab-keys button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .lab-keys code {
    font: 500 0.85rem/1.2 var(--mono);
    color: var(--accent);
  }
  .lab-keys small {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lab-meaning {
    margin: 0;
    min-height: 3.4em;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .lab-code figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 400 0.6rem/1.5 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .lab-code pre {
    margin: 0;
    padding: 0.9rem 0;
    overflow-x: auto;
    font: 0.82rem/1.9 var(--mono);
    color: var(--text-dim);
    tab-size: 4;
  }
  .lab-code code {
    display: grid;
    gap: 0.1rem;
  }
  .lab-code code > span {
    display: block;
    padding: 0.1rem 0.6rem;
    border-left: 2px solid transparent;
    white-space: pre;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  .lab-code code > span.is-lit {
    border-left-color: var(--accent);
    background: rgb(101 229 224 / 8%);
    color: var(--text);
  }
  .lab-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .lab-stop {
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--text);
    padding: 0.62rem 0.9rem;
    font-size: 0.75rem;
    min-height: 44px;
  }
  .lab-run .button {
    min-height: 44px;
    font-size: 0.78rem;
  }
  .lab-output {
    margin: 1rem 0 0;
    padding: 0.9rem 1rem;
    min-height: 8.5rem;
    max-height: 13rem;
    overflow: auto;
    background: #0a1426;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    color: #d6e6f5;
    font: 0.8rem/1.75 var(--mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .lab-output[data-error='true'] {
    color: #ffb6a6;
    border-color: rgb(255 182 166 / 40%);
  }
  .lab-status {
    margin: 0.7rem 0 0;
    font: 0.65rem/1.6 var(--mono);
    color: var(--accent);
    min-height: 1.6em;
  }
  .lab-status[data-tone='quiet'] {
    color: var(--muted);
  }
  .lab-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-soft);
    font: 0.63rem/1.5 var(--mono);
    color: var(--muted);
  }
  .lab-foot .text-link {
    font-size: 0.68rem;
  }
  @media (max-width: 1080px) {
    .hero-lab {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .lab-words {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
    }
  }
  @media (max-width: 720px) {
    .hero-lab {
      grid-template-columns: 1fr;
    }
    .lab-code {
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .lab-words,
    .lab-code,
    .lab-run {
      padding: 1.1rem;
    }
    .lab-code pre {
      font-size: 0.76rem;
    }
    .lab-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-keys button,
    .lab-code code > span {
      transition: none;
    }
  }
</style>
