--accent);box-shadow:0 0 12px var(--accent)}.playground-engine-status[data-state=loading] i{background:#a58cff;box-shadow:0 0 12px #a58cff}.playground-engine-status[data-state=error] i{background:#ff7979}.playground-toolbar{background:#0b1020}.example-picker{display:grid;gap:.35rem;color:var(--muted);font:.58rem var(--mono);letter-spacing:.1em}.example-picker select{max-width:min(56vw,340px);border:1px solid var(--line);border-radius:7px;background:#10182b;color:var(--text);padding:.55rem .7rem;font:.76rem var(--sans);letter-spacing:0}.editor-actions{display:flex;align-items:center;gap:.6rem}.tg-quiet-button,.pane-heading button{padding:.55rem .75rem;border:1px solid var(--line);border-radius:6px;background:transparent;color:#aab5ce;font-size:.72rem}.tg-run-button{display:inline-flex;align-items:center;gap:.55rem;padding:.68rem .95rem;border:1px solid var(--accent-line);border-radius:7px;background:var(--accent);color:#08100a;font-weight:700;font-size:.75rem}.tg-run-button:disabled{opacity:.6;cursor:wait}.tg-run-button kbd{padding:.12rem .25rem;border:1px solid rgb(0 0 0 / 18%);border-radius:3px;font:.58rem var(--mono)}.playground-workspace{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);min-height:430px}.editor-pane,.output-pane{min-width:0;display:flex;flex-direction:column}.editor-pane{border-right:1px solid var(--line)}.pane-heading{display:flex;align-items:center;justify-content:space-between;min-height:42px;padding:.5rem .9rem;border-bottom:1px solid var(--line-soft);color:#aab5ce;font:.64rem var(--mono)}.pane-heading>span:first-child{display:flex;align-items:center;gap:.5rem}.pane-heading>span i{background:var(--accent)}.pane-heading button{padding:.28rem .5rem;font-size:.62rem}.editor-pane textarea{flex:1;width:100%;min-height:340px;resize:vertical;border:0;outline:0;padding:1.15rem;background:#080d1b;color:#dce4ff;font:.84rem/1.85 'SFMono-Regular',Consolas,monospace;tab-size:4;white-space:pre;overflow:auto}.editor-pane textarea:focus-visible,.stdin-panel textarea:focus-visible{outline:1px solid var(--accent);outline-offset:-2px}.editor-foot{display:flex;gap:1rem;padding:.5rem .9rem;border-top:1px solid var(--line-soft);color:#7885a4;font:.57rem var(--mono)}.terminal-output{flex:1;min-height:220px;max-height:360px;overflow:auto;padding:1rem;background:radial-gradient(ellipse at 100% 0%,rgb(139 112 255 / 8%),transparent 55%),#070b16}.terminal-welcome{color:var(--muted);font-size:.8rem}.terminal-welcome span{color:var(--accent);font:.65rem var(--mono)}.terminal-welcome p{margin:.6rem 0 .25rem;color:#cbd4e9}.terminal-welcome small{font-size:.68rem}.terminal-text{margin:0;color:#dce8d4;font:.78rem/1.8 'SFMono-Regular',Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.terminal-error{color:#ffb0a7}.stdin-panel{padding:.8rem .9rem;border-top:1px solid var(--line);background:#0a1020}.stdin-panel label{display:flex;justify-content:space-between;gap:.5rem;align-items:center;margin-bottom:.5rem}.stdin-panel label span{color:var(--accent);font:.6rem var(--mono);letter-spacing:.1em}.stdin-panel label small{color:var(--muted);font-size:.62rem}.stdin-panel textarea{width:100%;resize:vertical;border:1px solid var(--line);border-radius:6px;padding:.55rem .65rem;background:#080d1b;color:#dce4ff;font:.72rem/1.6 'SFMono-Regular',Consolas,monospace}.playground-bottom{border-top:1px solid var(--line);border-bottom:0;background:#090e1c}.run-meta{display:flex;gap:1rem;color:var(--muted);font:.62rem var(--mono)}.playground-bottom a{color:#b8c3dd;font-size:.7rem}.playground-bottom a:hover{color:var(--accent)}.playground-proof{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1rem}.playground-proof>div{padding:1.1rem;border:1px solid var(--line);border-radius:10px;background:rgb(12 18 35 / 65%)}.proof-symbol{color:var(--accent);font:.62rem var(--mono)}.playground-proof strong{display:block;margin:.55rem 0 .3rem;font-size:.85rem}.playground-proof p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.6}.playground-note{max-width:100ch;margin:1rem auto 0;color:var(--muted);font-size:.68rem;line-height:1.7}
