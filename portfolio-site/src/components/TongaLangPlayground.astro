---
const sourceRevision = '956909b5f64d9114b2796397727be4f665726703';
const examples = [{"name":"Hello, TongaLang","source":"mulimo matalikilo() {\n    amba(\"Muli bwanji, TongaLang!\")\n    amba(\"This is the real interpreter.\")\n}","input":""},{"name":"Variables and types","source":"zina zyina = \"Leo\"\nzina myaka = 20\nzina musikwiiya = iiyi\n\nmulimo matalikilo() {\n    amba(\"Zyina: \" + zyina)\n    amba(\"Myaka: \" + myaka)\n    amba(\"Musikwiiya: \" + musikwiiya)\n}","input":""},{"name":"Functions and conditions","source":"mulimo yungizya(a, b) {\n    pilula a + b\n}\n\nmulimo matalikilo() {\n    zina zyoonse = yungizya(10, 20)\n    kuti (zyoonse inda 25) {\n        amba(\"The result is greater than 25\")\n    } nakunyina {\n        amba(\"The result is 25 or less\")\n    }\n    amba(\"Result: \" + zyoonse)\n}","input":""},{"name":"Range loop","source":"mulimo matalikilo() {\n    induluka i kuzwa 1 kusika 5 {\n        amba(\"Iteration: \" + i)\n    }\n}","input":""},{"name":"Interactive input · bala()","source":"mulimo matalikilo() {\n    zina cipimo = bala(\"Enter a mark (0–100): \")\n    kuti (cipimo >= 70) {\n        amba(\"Result: Kabotu loko\")\n    } naaba (cipimo >= 60) {\n        amba(\"Result: Kabotu\")\n    } naaba (cipimo >= 50) {\n        amba(\"Result: Wazwidilila\")\n    } nakunyina {\n        amba(\"Result: Kobweza alimwi\")\n    }\n}","input":"82"}];
---
<section class="tongalang-playground section-shell" id="tongalang-playground" data-scene="tongalang-playground">
  <div class="playground-intro" data-motion>
    <div>
      <p class="eyebrow">03 · The language, running for real</p>
      <h2>Meet <em>TongaLang.</em><br/>Then write it yourself.</h2>
      <p class="playground-lede">Not a mock terminal. This playground loads the actual Python lexer, PLY parser, AST and interpreter from the TongaLang repository and runs your code locally in your browser.</p>
    </div>
    <div class="engine-stamp"><span class="engine-pulse"></span><span>REAL LANGUAGE ENGINE</span><strong>v0.2.0</strong><small>Source-pinned · Browser-local</small></div>
  </div>
  <div class="playground-shell" data-tg-playground>
    <div class="playground-topbar">
      <div class="playground-brand"><span class="tg-mark">T</span><span><strong>TongaLang Studio</strong><small>Interactive language playground</small></span></div>
      <div class="playground-engine-status" data-tg-status><i></i><span data-tg-status-text>Engine not loaded</span></div>
    </div>
    <div class="playground-toolbar">
      <label class="example-picker">START WITH AN EXAMPLE
        <select data-tg-example>{examples.map((example, index) => <option value={index}>{example.name}</option>)}</select>
      </label>
      <div class="editor-actions"><button type="button" class="tg-quiet-button" data-tg-reset>Reset</button><button type="button" class="tg-run-button" data-tg-run disabled>▶ Run program <kbd>Ctrl ↵</kbd></button></div>
    </div>
    <div class="playground-workspace">
      <div class="editor-pane">
        <div class="pane-heading"><span><i></i> main.tg</span><span data-tg-line-count>1 line</span></div>
        <label class="sr-only" for="tongalang-source">TongaLang source code editor</label>
        <textarea id="tongalang-source" data-tg-source spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" aria-describedby="tg-editor-help">{examples[0].source}</textarea>
        <div class="editor-foot" id="tg-editor-help"><span>Language: TongaLang</span><span>UTF-8</span><span>Spaces: 4</span></div>
      </div>
      <div class="output-pane">
        <div class="pane-heading"><span><i></i> Program output</span><button type="button" data-tg-clear>Clear</button></div>
        <div class="terminal-output" data-tg-output aria-live="polite" aria-label="Program output"><div class="terminal-welcome"><span>01</span><p>Your program output will appear here.</p><small>Choose an example or write your own TongaLang code, then run it.</small></div></div>
        <div class="stdin-panel"><label for="tongalang-stdin"><span>PROGRAM INPUT</span><small>One value per line · used by bala()</small></label><textarea id="tongalang-stdin" data-tg-stdin rows="2" spellcheck="false" placeholder="Enter input values here, one per line...">{examples[0].input}</textarea></div>
      </div>
    </div>
    <div class="playground-bottom"><div class="run-meta"><span data-tg-run-state>Ready</span><span data-tg-duration></span></div><a href="https://github.com/leomabuku/PROJECT" target="_blank" rel="noreferrer">Inspect the language source ↗</a></div>
  </div>
  <div class="playground-proof">
    <div><span class="proof-symbol">01</span><strong>Real lexer & parser</strong><p>PLY tokenization and grammar from the original project.</p></div>
    <div><span class="proof-symbol">02</span><strong>Actual interpreter</strong><p>Variables, functions, conditions, loops and native functions execute as implemented.</p></div>
    <div><span class="proof-symbol">03</span><strong>Your browser, your code</strong><p>Execution happens locally. Source code is not sent to a portfolio server.</p></div>
  </div>
  <p class="playground-note">The Python runtime and TongaLang engine are downloaded on first use. Code runs in a browser-side WebAssembly Python runtime with loop and call-depth limits. This is an educational sandbox, not a secure environment for secrets or sensitive data.</p>
</section>
<script>
  import { loadPyodide } from 'https://cdn.jsdelivr.net/pyodide/v0.27.7/full/pyodide.mjs';
  const REVISION = '956909b5f64d9114b2796397727be4f665726703';
  const MODULES = ['ast_nodes.py','environment.py','errors.py','interpreter.py','lexer.py','native_functions.py','parser.py'];
  let enginePromise;
  const runnerCode = [
    'import builtins, contextlib, io, json',
    'from tongalang.parser import parse_source',
    'from tongalang.interpreter import Interpreter',
    'def _run_tongalang(source, stdin_text):',
    '    output = io.StringIO()',
    '    values = iter(stdin_text.splitlines())',
    '    original_input = builtins.input',
    '    def read_input():',
    '        try: return next(values)',
    '        except StopIteration: raise EOFError("Program requested input, but no input value was supplied.")',
    '    try:',
    '        with contextlib.redirect_stdout(output):',
    '            builtins.input = read_input',
    '            try:',
    '                program = parse_source(source)',
    '                Interpreter(max_loop_iterations=1000, max_call_depth=100).interpret(program)',
    '            finally: builtins.input = original_input',
    '        return json.dumps({"ok": True, "output": output.getvalue()})',
    '    except Exception as error:',
    '        builtins.input = original_input',
    '        message = error.format_message(source=source) if hasattr(error, "format_message") else str(error)',
    '        return json.dumps({"ok": False, "output": output.getvalue(), "error": message, "code": getattr(error, "code", "TL-RUNTIME")})'
  ].join('\n');
  async function loadEngine() {
    if (!enginePromise) {
      enginePromise = (async () => {
        const py = await loadPyodide({indexURL:'https://cdn.jsdelivr.net/pyodide/v0.27.7/full/'});
        await py.loadPackage('micropip');
        await py.runPythonAsync("import micropip\nawait micropip.install('ply==3.11')");
        py.FS.mkdirTree('/home/pyodide/tongalang');
        py.FS.writeFile('/home/pyodide/tongalang/__init__.py','');
        const files = await Promise.all(MODULES.map(async name => {
          const response = await fetch('https://raw.githubusercontent.com/leomabuku/PROJECT/' + REVISION + '/tongalang/' + name);
          if (!response.ok) throw new Error('Could not load engine module: ' + name);
          return [name, await response.text()];
        }));
        for (const [name, code] of files) py.FS.writeFile('/home/pyodide/tongalang/' + name, code);
        await py.runPythonAsync("import sys\nsys.path.insert(0, '/home/pyodide')");
        await py.runPythonAsync(runnerCode);
        return py;
      })().catch(error => { enginePromise = undefined; throw error; });
    }
    return enginePromise;
  }
  function initializePlayground() {
    const root = document.querySelector('[data-tg-playground]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const status = root.querySelector('[data-tg-status-text]');
    const statusBox = root.querySelector('[data-tg-status]');
    const editor = root.querySelector('[data-tg-source]');
    const stdin = root.querySelector('[data-tg-stdin]');
    const select = root.querySelector('[data-tg-example]');
    const run = root.querySelector('[data-tg-run]');
    const output = root.querySelector('[data-tg-output]');
    const state = root.querySelector('[data-tg-run-state]');
    const duration = root.querySelector('[data-tg-duration]');
    const lineCount = root.querySelector('[data-tg-line-count]');
    const examples = [{"name":"Hello, TongaLang","source":"mulimo matalikilo() {\n    amba(\"Muli bwanji, TongaLang!\")\n    amba(\"This is the real interpreter.\")\n}","input":""},{"name":"Variables and types","source":"zina zyina = \"Leo\"\nzina myaka = 20\nzina musikwiiya = iiyi\n\nmulimo matalikilo() {\n    amba(\"Zyina: \" + zyina)\n    amba(\"Myaka: \" + myaka)\n    amba(\"Musikwiiya: \" + musikwiiya)\n}","input":""},{"name":"Functions and conditions","source":"mulimo yungizya(a, b) {\n    pilula a + b\n}\n\nmulimo matalikilo() {\n    zina zyoonse = yungizya(10, 20)\n    kuti (zyoonse inda 25) {\n        amba(\"The result is greater than 25\")\n    } nakunyina {\n        amba(\"The result is 25 or less\")\n    }\n    amba(\"Result: \" + zyoonse)\n}","input":""},{"name":"Range loop","source":"mulimo matalikilo() {\n    induluka i kuzwa 1 kusika 5 {\n        amba(\"Iteration: \" + i)\n    }\n}","input":""},{"name":"Interactive input · bala()","source":"mulimo matalikilo() {\n    zina cipimo = bala(\"Enter a mark (0–100): \")\n    kuti (cipimo >= 70) {\n        amba(\"Result: Kabotu loko\")\n    } naaba (cipimo >= 60) {\n        amba(\"Result: Kabotu\")\n    } naaba (cipimo >= 50) {\n        amba(\"Result: Wazwidilila\")\n    } nakunyina {\n        amba(\"Result: Kobweza alimwi\")\n    }\n}","input":"82"}];
    const setStatus = (message, kind='') => { status.textContent=message; statusBox.dataset.state=kind; };
    const updateLines = () => { const n=editor.value.split('\n').length; lineCount.textContent=n+(n===1?' line':' lines'); };
    const showOutput = (text, failed=false) => { output.replaceChildren(); const pre=document.createElement('pre'); pre.className=failed?'terminal-text terminal-error':'terminal-text'; pre.textContent=text||'Program completed with no output.'; output.append(pre); };
    const reset = () => { const item=examples[Number(select.value)]||examples[0]; editor.value=item.source; stdin.value=item.input; updateLines(); showOutput('Ready to run this example.'); state.textContent='Ready'; duration.textContent=''; };
    editor.addEventListener('input',updateLines);
    select.addEventListener('change',reset);
    root.querySelector('[data-tg-reset]').addEventListener('click',reset);
    root.querySelector('[data-tg-clear]').addEventListener('click',()=>{showOutput('Output cleared.');state.textContent='Ready';duration.textContent='';});
    editor.addEventListener('keydown',event=>{
      if(event.key==='Tab'){event.preventDefault();editor.setRangeText('    ',editor.selectionStart,editor.selectionEnd,'end');updateLines();}
      if((event.ctrlKey||event.metaKey)&&event.key==='Enter'){event.preventDefault();run.click();}
    });
    run.addEventListener('click',async()=>{
      run.disabled=true;run.textContent='Loading engine…';setStatus('Starting Python runtime','loading');state.textContent='Preparing actual TongaLang engine…';duration.textContent='';
      const started=performance.now();
      try {
        const py=await loadEngine();setStatus('Engine ready · local execution','ready');run.textContent='Running…';
        py.globals.set('tg_source_input',editor.value);py.globals.set('tg_stdin_input',stdin.value);
        const proxy=py.runPython('_run_tongalang(tg_source_input, tg_stdin_input)');
        const result=JSON.parse(proxy.toString());proxy.destroy();
        showOutput(result.ok?result.output:result.output+(result.output?'\n':'')+result.error,!result.ok);
        state.textContent=result.ok?'Execution completed':'Execution stopped · '+result.code;
        duration.textContent=Math.round(performance.now()-started)+' ms';setStatus('Engine ready · local execution','ready');
      } catch(error) {
        showOutput('Could not start the real TongaLang runtime.\n'+(error?.message||String(error)),true);
        state.textContent='Engine failed to start';setStatus('Engine unavailable','error');
      } finally {run.disabled=false;run.innerHTML='▶ Run program <kbd>Ctrl ↵</kbd>';}
    });
    updateLines();setStatus('Load on first run','');run.disabled=false;
  }
  document.addEventListener('astro:page-load',initializePlayground);
  initializePlayground();
</script>
<style>
