---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '../components/CommandPalette.astro';
import { profile, whatsappUrl } from '../data/site';
const {
  title = `${profile.name} | Software Developer and Computer Science Student`,
  description = 'Portfolio of Leo Mabuku, a Computer Science student and software developer building web, Android, systems and educational software projects in Zambia.',
  image = '/og.png',
  schema = {},
} = Astro.props;
const path = Astro.url.pathname;
const nav = [['/', 'Home'], ['/work/', 'Work'], ['/about/', 'About'], ['/resume/', 'Resume'], ['/contact/', 'Contact']];
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Software Developer and Computer Science Student',
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Kitwe', addressCountry: 'ZM' },
  sameAs: [profile.github, profile.linkedin],
  ...schema,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a0a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Leo Mabuku — software developer, Computer Science student and entrepreneur" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>
  <body data-page={path === '/' ? 'home' : path.split('/').filter(Boolean)[0] ?? 'home'}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="experience-rail" aria-hidden="true"><span data-experience-progress></span></div>
    <header class="site-header" transition:name="site-header">
      <a class="monogram" href="/" aria-label="Leo Mabuku home"><span>L</span><b>M</b></a>
      <nav id="primary-nav" aria-label="Primary navigation">
        {nav.map(([href, label]) => <a href={href} class:list={{ active: href === '/' ? path === '/' : path.startsWith(href) }}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <button type="button" class="command-trigger" data-command-open aria-label="Open quick navigation"><i class="ph ph-command" aria-hidden="true"></i><span>Quick find</span><kbd>⌘K</kbd></button>
        <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav"><i class="ph ph-list" aria-hidden="true"></i></button>
      </div>
    </header>
    <main id="main" data-route={path}><slot /></main>
    <footer class="site-footer" data-motion>
      <div><p class="eyebrow">Let’s connect</p><h2>Build something<br/><em>useful</em> together.</h2><p class="footer-note">Available for graduate roles, internships, freelance work and technical collaborations.</p></div>
      <div class="footer-links">
        <a href={`mailto:${profile.email}`}><i class="ph ph-envelope-simple" aria-hidden="true"></i><span>Email<small>{profile.email}</small></span></a>
        <a href={profile.github} target="_blank" rel="noreferrer"><i class="ph ph-github-logo" aria-hidden="true"></i><span>GitHub<small>github.com/leomabuku</small></span></a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer"><i class="ph ph-linkedin-logo" aria-hidden="true"></i><span>LinkedIn<small>Leo Mabuku</small></span></a>
        <a href={whatsappUrl} target="_blank" rel="noreferrer"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i><span>WhatsApp<small>{profile.phone}</small></span></a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Leo Mabuku · Kitwe, Zambia</p>
    </footer>
    <CommandPalette />
    <script>
      import { destroyExperience, initExperience } from '../scripts/experience';

      const startExperience = () => initExperience();
      document.addEventListener('astro:page-load', startExperience);
      document.addEventListener('astro:before-swap', destroyExperience);
      startExperience();
    </script>
  </body>
</html>
