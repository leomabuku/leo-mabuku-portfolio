---
import '../styles/global.css';
import '@phosphor-icons/web/regular';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '../components/CommandPalette.astro';
import { profile, whatsappUrl } from '../data/site';
const {
  title = `${profile.name} | Software Developer and Computer Science Graduate`,
  description = 'Portfolio of Leo Mabuku, a Computer Science graduate and software developer building web, Android, IoT and systems projects in Zambia.',
  image = '/og.png',
  schema = {},
} = Astro.props;
const path = Astro.url.pathname;
const nav = [['/work/', 'Work'], ['/about/', 'About'], ['/playground/', 'Playground'], ['/resume/', 'Resume'], ['/notes/', 'Notes'], ['/contact/', 'Contact']];
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const websiteSchema = path === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).toString(),
  name: 'Leo Mabuku',
  alternateName: ['Leo Mabuku Portfolio', 'leomabuku.me'],
  url: Astro.site?.toString(),
  publisher: { '@id': new URL('/#person', Astro.site).toString() },
} : null;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).toString(),
  name: profile.name,
  jobTitle: 'Software Developer and Computer Science Graduate',
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Lusaka', addressCountry: 'ZM' },
  sameAs: [profile.github, profile.linkedin],
  ...schema,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151715" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Leo Mabuku, software developer, Computer Science graduate and entrepreneur" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
    {websiteSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>
  <body data-page={path === '/' ? 'home' : path.split('/').filter(Boolean)[0] ?? 'home'}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="experience-rail" aria-hidden="true"><span data-experience-progress></span></div>
    <header class="site-header" data-site-header transition:name="site-header">
      <a class="monogram" href="/" aria-label="Leo Mabuku home"><span class="brand-symbol" aria-hidden="true">lm.</span><span>Leo Mabuku<span class="brand-caption">Developer & entrepreneur</span></span></a>
      <nav id="primary-nav" aria-label="Primary navigation">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined} class:list={{ active: path.startsWith(href) }}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="header-cta" href="/contact/">Hire me</a>
        <button type="button" class="command-trigger" data-command-open aria-label="Open quick navigation"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></button>
        <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav"><i class="ph ph-list" aria-hidden="true"></i></button>
      </div>
    </header>
    <main id="main" data-route={path}><slot /></main>
    <footer class="site-footer" data-motion>
      <div><p class="eyebrow">Let’s connect</p><h2>Build something<br/><em>useful</em> together.</h2><p class="footer-note">{profile.status}. Available for internships, graduate roles, freelance builds and technical collaborations.</p></div>
      <div class="footer-links">
        <a href={`mailto:${profile.email}`}><i class="ph ph-envelope-simple" aria-hidden="true"></i><span>Email<small>{profile.email}</small></span></a>
        <a href={profile.github} target="_blank" rel="noreferrer"><i class="ph ph-github-logo" aria-hidden="true"></i><span>GitHub<small>github.com/leomabuku</small></span></a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer"><i class="ph ph-linkedin-logo" aria-hidden="true"></i><span>LinkedIn<small>Leo Mabuku</small></span></a>
        <a href={whatsappUrl} target="_blank" rel="noreferrer"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i><span>WhatsApp<small>{profile.phone}</small></span></a>
      </div>
      <div class="footer-base">
        <p class="copyright">© {new Date().getFullYear()} Leo Mabuku · {profile.location}</p>
        <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">Reduce motion</button>
        <p class="visit-counter" data-visit-counter hidden>
          <i class="ph ph-eye" aria-hidden="true"></i>
          <span data-visit-total></span> visits
          <span class="visit-sep" aria-hidden="true">·</span>
          <span data-visit-today></span> today
        </p>
      </div>
    </footer>
    <CommandPalette />
    <script>
      import { destroyExperience, initExperience } from '../scripts/experience';
      if (import.meta.env.DEV) import('../scripts/qa-audit');

      const startExperience = () => initExperience();
      document.addEventListener('astro:page-load', startExperience);
      document.addEventListener('astro:before-swap', destroyExperience);
      startExperience();
    </script>
  </body>
</html>
