---
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = [
  {
    title: 'TongaLang: Building a Programming Language with Tonga-Derived Syntax',
    href: '/notes/tongalang-language-design/',
    date: '11 November 2026',
    readingTime: '8 min read',
    dek: 'How I built an interpreted educational language with Tonga-derived keywords, a Python runtime and a guided desktop IDE.',
    topic: 'Programming Languages',
  },
  {
    title: 'What 48 hours at GreenCode actually taught me about shipping',
    href: '/notes/greencode-48-hours/',
    date: '2 November 2026',
    readingTime: '7 min read',
    dek: 'Two days, a water problem and no working prototype. What survived contact with the clock, and what I’d do differently.',
    topic: 'Building',
  },
];
---

<BaseLayout
  title="Notes | Leo Mabuku"
  description="Writing by Leo Mabuku on building software, programming languages, IoT systems and technology in Zambia."
>
  <section class="page-hero" data-motion data-scene="notes">
    <p class="eyebrow">Notes · Writing</p>
    <h1>Thinking out loud,<br/><em>in public.</em></h1>
    <p>Writing about the systems I build, the decisions behind them and what I learn along the way. Technical detail, honest limitations and working evidence.</p>
    <div class="page-hero-status" aria-hidden="true"><span>Build</span><span>Operate</span><span>Explain</span></div>
  </section>

  <section class="section-shell">
    <div class="notes-list" data-motion-stagger>
      {notes.map((note) => (
        <article class="note-row">
          <p class="note-meta">{note.date} · {note.topic} · {note.readingTime}</p>
          <h2><a href={note.href}>{note.title}</a></h2>
          <p>{note.dek}</p>
          <a class="text-link" href={note.href}>Read the note <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
