---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import { profile, featuredProjects } from '../data/site';
const services = [
  ['ph-code', 'Software development', 'I translate requirements into clear, maintainable applications and systems.'],
  ['ph-browser', 'Web development', 'I build responsive, content-driven web experiences with practical deployment in mind.'],
  ['ph-device-mobile', 'Android development', 'I develop Kotlin-based mobile applications around real user and business workflows.'],
  ['ph-flow-arrow', 'Systems thinking', 'I break complex problems into connected parts, rules, data and dependable interfaces.'],
];
---
<BaseLayout>
  <div class="intro-sequence" data-intro-sequence hidden aria-hidden="true">
    <div class="intro-mark" data-intro-mark><span>L</span><span>M</span></div>
    <span class="intro-line" data-intro-line></span>
    <p>Developer · Student · Entrepreneur</p>
  </div>

  <section class="hero" data-home-hero data-scene="identity">
    <div class="hero-copy" data-motion>
      <p class="location"><i class="ph ph-map-pin" aria-hidden="true"></i>{profile.location}</p>
      <h1><span>Leo</span><br/><em>Mabuku</em></h1>
      <p class="role">Software Developer <span>·</span> Student <span>·</span> Entrepreneur</p>
      <div class="rule" data-hero-signal></div>
      <p class="intro">{profile.intro}</p>
      <div class="actions"><a class="button" href="#featured">View my work <i class="ph ph-arrow-right" aria-hidden="true"></i></a><a class="text-link" href="/contact/">Contact Leo <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
      <a class="scroll-cue" href="#capabilities"><span>Scroll to explore</span><i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </div>
    <div class="hero-image" data-portrait-stage data-motion>
      <img data-portrait-image src={profile.avatar} alt="Leo Mabuku wearing a dark suit in a black-and-white portrait" fetchpriority="high" />
      <canvas class="portrait-canvas" data-portrait-canvas aria-hidden="true"></canvas>
      <div class="portrait-scan" aria-hidden="true"></div>
      <div class="portrait-readout" aria-hidden="true"><span>LM / Identity signal</span><strong>Live system</strong></div>
    </div>
  </section>

  <section class="credibility-strip" aria-label="Professional summary" data-motion-stagger>
    <span>Fourth-year Computer Science student</span><span>Based in Kitwe, Zambia</span><span>Web · Android · Systems</span><span>Open to opportunities</span>
  </section>

  <section class="section-shell services-section" id="capabilities" data-scene="capabilities">
    <div class="section-heading" data-motion><p class="eyebrow">01 · Capabilities</p><h2>From analysis to<br/><em>working software.</em></h2><p>My strongest work connects technical decisions to useful outcomes.</p></div>
    <div class="services-grid" data-motion-stagger>{services.map(([icon, title, text], index) => <article data-motion><span class="service-index">0{index + 1}</span><i class={`ph ${icon}`} aria-hidden="true"></i><h3>{title}</h3><p>{text}</p></article>)}</div>
  </section>

  <section class="section-shell featured-section" id="featured" data-scene="proof">
    <div class="section-heading section-heading--row" data-motion><div><p class="eyebrow">02 · Featured work</p><h2>Evidence across<br/><em>different systems.</em></h2></div><a class="text-link" href="/work/">Explore all projects <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
    <div class="project-grid">{featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>

  <section class="business-proof" data-motion data-scene="operations">
    <div><p class="eyebrow">03 · Built through code and business</p><h2>Technical decisions grounded in <em>real operations.</em></h2></div>
    <div><p>Before and during university, I have managed retail operations, handled procurement and customer relationships, repaired computers and launched a Starlink-powered internet service. Those experiences influence how I build software: around actual users, constraints and workflows.</p><dl><div><dt data-count="29">29</dt><dd>active internet-service subscribers</dd></div><div><dt data-count="2022">2022</dt><dd>Leo M. Suppliers formally registered</dd></div><div><dt data-count="3">3</dt><dd>connected disciplines: software, business and networking</dd></div></dl></div>
  </section>

  <AvailabilityBanner />
</BaseLayout>
