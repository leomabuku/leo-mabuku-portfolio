---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import HackathonSpotlight from '../components/HackathonSpotlight.astro';
import { profile, featuredProjects, projects } from '../data/site';

const services = [
  ['ph-device-mobile', 'Android & mobile', 'Kotlin and Jetpack Compose products built around real operator and customer workflows.'],
  ['ph-browser', 'Web platforms', 'React and Astro interfaces that carry real data, real states and real pressure.'],
  ['ph-database', 'APIs & data', 'Express and FastAPI services over PostgreSQL, Supabase and SQLite with tested contracts.'],
  ['ph-cpu', 'Systems & IoT', 'C system simulacra, interpreters, ESP32 firmware and the network in between.'],
];

const marquee = [
  'Android · Jetpack Compose',
  'React & Astro',
  'Node & Express APIs',
  'Python & FastAPI',
  'PostgreSQL & Supabase',
  'ESP32 & IoT telemetry',
  'MikroTik automation',
  'Systems programming in C',
  'Realtime delivery with SSE',
];

const spotlightProjects = featuredProjects.slice(0, 6);
const numberWords: Record<number, string> = { 6: 'Six', 7: 'Seven', 8: 'Eight', 9: 'Nine', 10: 'Ten', 11: 'Eleven', 12: 'Twelve' };
const projectCountWord = numberWords[projects.length] ?? String(projects.length);
---
<BaseLayout>
  <div class="intro-sequence" data-intro-sequence hidden aria-hidden="true">
    <div class="intro-mark" data-intro-mark><span>L</span><span>M</span></div>
    <span class="intro-line" data-intro-line></span>
    <p>Developer · Graduate · Entrepreneur</p>
  </div>

  <section class="hero" data-home-hero data-scene="identity">
    <div class="hero-copy" data-motion>
      <p class="hero-status">{profile.status}</p>
      <h1><span>Leo</span><em>Mabuku</em></h1>
      <p class="role">Software Developer <span>·</span> Computer Science Graduate <span>·</span> Entrepreneur</p>
      <div class="rule" data-hero-signal></div>
      <p class="intro">{profile.intro}</p>
      <div class="actions">
        <a class="button" href="#featured">See the evidence <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
        <a class="text-link" href="/documents/Leo-Mabuku-Resume.pdf" download>Download resume <i class="ph ph-download-simple" aria-hidden="true"></i></a>
      </div>
      <dl class="hero-stats">
        <div><dt data-count={projects.length}>{projects.length}</dt><dd>shipped projects</dd></div>
        <div><dt data-count="37">37</dt><dd>paying subscribers live</dd></div>
        <div><dt data-count="6">6</dt><dd>top six · GreenCode</dd></div>
      </dl>
      <a class="scroll-cue" href="#capabilities"><span>Scroll to explore</span><i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </div>

    <div class="hero-image" data-portrait-stage data-motion>
      <img data-portrait-image src={profile.avatar} alt="Leo Mabuku in a dark suit, photographed in black and white" fetchpriority="high" />
      <canvas class="portrait-canvas" data-portrait-canvas aria-hidden="true"></canvas>
      <div class="portrait-scan" aria-hidden="true"></div>
      <div class="portrait-readout" aria-hidden="true"><span>LM / Identity signal</span><strong>Live system</strong></div>
    </div>

    <div class="hero-marquee" aria-hidden="true">
      <div class="hero-marquee-track">
        {[...marquee, ...marquee].map((item) => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <section class="credibility-strip" aria-label="Professional summary" data-motion-stagger>
    <span>Computer Science graduate · CBU</span>
    <span>IoT intern · CodeAlpha</span>
    <span>{profile.location}</span>
    <span>Web · Android · IoT · Systems</span>
    <span>Open to internships &amp; graduate roles</span>
  </section>

  <section class="section-shell services-section" id="capabilities" data-scene="capabilities">
    <div class="section-heading" data-motion>
      <p class="eyebrow">01 · What I build</p>
      <h2>From a real problem to<br/><em>running software.</em></h2>
      <p>Every project here started with an operational problem, not a tutorial. The common thread is a system that has to hold up when someone depends on it.</p>
    </div>
    <div class="services-grid" data-motion-stagger>
      {services.map(([icon, title, text], index) => (
        <article>
          <span class="service-index">0{index + 1}</span>
          <i class={`ph ${icon}`} aria-hidden="true"></i>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell featured-section" id="featured" data-scene="proof">
    <div class="section-heading section-heading--row" data-motion>
      <div>
        <p class="eyebrow">02 · Selected evidence</p>
        <h2>{projectCountWord} projects.<br/><em>Inspect the evidence.</em></h2>
      </div>
      <a class="text-link" href="/work/">All {projects.length} case studies <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="project-grid">
      {spotlightProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <HackathonSpotlight eyebrow="03 · Hackathons & recognition" />

  <section class="business-proof" data-motion data-scene="operations">
    <div>
      <p class="eyebrow">04 · Built in the real world</p>
      <h2>Software shaped by <em>operating something.</em></h2>
    </div>
    <div>
      <p>Before and during university I ran a registered retail business, handled procurement and customer relationships, repaired computers, and launched a Starlink-powered internet service. SubTrack BH exists because that service needed it. That is the difference between a demo and a system: someone is relying on it on a Monday morning.</p>
      <dl>
        <div><dt data-count="37">37</dt><dd>paying internet subscribers today</dd></div>
        <div><dt data-count="2022">2022</dt><dd>Leo M. Suppliers registered</dd></div>
        <div><dt data-count="6">6</dt><dd>top-six team at GreenCode</dd></div>
      </dl>
    </div>
  </section>

  <AvailabilityBanner />
</BaseLayout>
