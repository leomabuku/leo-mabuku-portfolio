---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import HackathonRecord from '../components/HackathonRecord.astro';
import { education, experience, skillGroups, certifications, hackathons, resumeSettings, projects } from '../data/site';

const resumeProjects = resumeSettings.projectSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
const resumeMeta = {
  mode: resumeSettings.source === 'uploaded' ? 'uploaded' : 'generated',
  label: resumeSettings.source === 'uploaded' ? resumeSettings.uploaded.label : 'Generated from this site’s data',
  uploadedOn: resumeSettings.uploaded.uploadedOn,
};
---
<BaseLayout title="Resume | Leo Mabuku" description="Resume of Leo Mabuku: Computer Science graduate, software developer and entrepreneur in Zambia.">
  <section class="page-hero resume-hero" data-motion data-scene="resume"><p class="eyebrow">Resume · Capability record</p><h1>Skills backed by<br/><em>projects and operations.</em></h1><p>Computer Science graduate with practical work across Android, web, IoT, systems, interpreter development, business operations and networking. Currently an IoT intern at CodeAlpha.</p><div class="actions"><a class="button" href="/documents/Leo-Mabuku-Resume.pdf" download><i class="ph ph-download-simple" aria-hidden="true"></i> Download resume PDF</a><span class="resume-source-note">{resumeMeta.label}{resumeMeta.uploadedOn ? ' · ' + resumeMeta.uploadedOn : ''}</span></div><div class="page-hero-status" aria-hidden="true"><span>Software</span><span>Systems</span><span>Operations</span></div></section>
  <div class="resume-document section-shell">
    <section class="resume-summary" data-motion><p class="eyebrow">Professional summary</p><h2>Software developer with a practical, systems-oriented approach.</h2><p>{resumeSettings.summary}</p></section>
    <section class="resume-section resume-capability-map" data-motion><p class="eyebrow">Technical skills</p><div class="skill-groups" data-motion-stagger>{skillGroups.map((group, index) => <div><span class="capability-index">0{index + 1}</span><h3>{group.title}</h3><div class="tag-list">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Experience</p><div class="timeline" data-motion-stagger>{experience.map((item) => <article><div class="timeline-meta"><span>{item.period}</span><small>{item.location}</small></div><div><h3>{item.title}</h3><h4>{item.organisation}</h4><p>{item.summary}</p><ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>{item.document && <a class="text-link" href={item.document.url} target="_blank" rel="noreferrer"><i class="ph ph-file-pdf" aria-hidden="true"></i>{item.document.label} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>}</div></article>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Education</p><div class="timeline" data-motion-stagger>{education.map((item) => <article><div class="timeline-meta"><span>{item.period}</span><small>{item.location}</small></div><div><h3>{item.qualification}</h3><h4>{item.institution}</h4><p>{item.detail}</p></div></article>)}</div></section>
    <section class="resume-section" id="hackathons" data-motion><p class="eyebrow">Hackathons &amp; awards</p><div class="timeline" data-motion-stagger>{hackathons.map((item) => <HackathonRecord hackathon={item} />)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Professional development</p><div class="timeline" data-motion-stagger>{certifications.map((item) => <article><div class="timeline-meta"><span>{item.period}</span></div><div><h3>{item.name}</h3><h4>{item.issuer}</h4></div></article>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Selected project evidence</p><div class="resume-projects" data-motion-stagger>{resumeProjects.map((project) => <a href={`/work/${project.slug}/`}><span><strong>{project.name}</strong><small>{project.role} · {project.status}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div></section>
  </div>
  <AvailabilityBanner />
</BaseLayout>
