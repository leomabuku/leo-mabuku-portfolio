---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import { education, experience, skillGroups, certifications, featuredProjects } from '../data/site';
---
<BaseLayout title="Resume | Leo Mabuku" description="Resume of Leo Mabuku: fourth-year Computer Science student, software developer and entrepreneur in Kitwe, Zambia.">
  <section class="page-hero resume-hero" data-motion data-scene="resume"><p class="eyebrow">Resume · Capability record</p><h1>Skills backed by<br/><em>projects and operations.</em></h1><p>Fourth-year Computer Science student with practical work across Android, web, systems, interpreter development, business operations and networking.</p><div class="actions"><a class="button" href="/documents/Leo-Mabuku-Resume.pdf" download><i class="ph ph-download-simple" aria-hidden="true"></i> Download resume PDF</a><a class="text-link" href="/documents/Leo-Mabuku-Resume.docx" download>Download Word version <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><div class="page-hero-status" aria-hidden="true"><span>Software</span><span>Systems</span><span>Operations</span></div></section>
  <div class="resume-document section-shell">
    <section class="resume-summary" data-motion><p class="eyebrow">Professional summary</p><h2>Software developer with a practical, systems-oriented approach.</h2><p>Fourth-year Bachelor of Science in Computer Science student with project experience in Android, web, systems and programming-language development. Combines problem analysis with entrepreneurship, live network operations, technical testing and user-focused product development.</p></section>
    <section class="resume-section resume-capability-map" data-motion><p class="eyebrow">Technical skills</p><div class="skill-groups" data-motion-stagger>{skillGroups.map((group, index) => <div><span class="capability-index">0{index + 1}</span><h3>{group.title}</h3><div class="tag-list">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Experience</p><div class="timeline" data-motion-stagger>{experience.map((item) => <article><div class="timeline-meta"><span>{item.period}</span><small>{item.location}</small></div><div><h3>{item.title}</h3><h4>{item.organisation}</h4><p>{item.summary}</p><ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div></article>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Education</p><div class="timeline" data-motion-stagger>{education.map((item) => <article><div class="timeline-meta"><span>{item.period}</span><small>{item.location}</small></div><div><h3>{item.qualification}</h3><h4>{item.institution}</h4><p>{item.detail}</p></div></article>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Professional development</p><div class="timeline" data-motion-stagger>{certifications.map((item) => <article><div class="timeline-meta"><span>{item.period}</span></div><div><h3>{item.name}</h3><h4>{item.issuer}</h4></div></article>)}</div></section>
    <section class="resume-section" data-motion><p class="eyebrow">Selected project evidence</p><div class="resume-projects" data-motion-stagger>{featuredProjects.map((project) => <a href={`/work/${project.slug}/`}><span><strong>{project.name}</strong><small>{project.role} · {project.status}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div></section>
  </div>
  <AvailabilityBanner />
</BaseLayout>
