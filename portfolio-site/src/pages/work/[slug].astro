---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AvailabilityBanner from '../../components/AvailabilityBanner.astro';
import { projects, hackathons, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const hackathon = project.hackathonSlug ? hackathons.find((item) => item.slug === project.hackathonSlug) : null;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const previous = projects[(currentIndex - 1 + projects.length) % projects.length];
const next = projects[(currentIndex + 1) % projects.length];

const repositories = [
  ...(project.repository ? [{ label: project.repositoryLabel ?? 'GitHub source', url: project.repository }] : []),
  ...(project.additionalRepositories ?? []),
];

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.name,
  description: project.shortDescription,
  codeRepository: project.repository || undefined,
  programmingLanguage: project.technologies,
  author: { '@type': 'Person', name: 'Leo Mabuku' },
};

const formattedUpdatedOn = project.updatedOn
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${project.updatedOn}T00:00:00`))
  : null;

const sections = [
  { id: 'context', label: 'Context' },
  { id: 'contribution', label: 'Contribution' },
  { id: 'capabilities', label: 'What it does' },
  ...(project.audience?.length ? [{ id: 'audience', label: 'Who it is for' }] : []),
  ...(project.media?.length ? [{ id: 'evidence', label: 'Screens' }] : []),
  ...(project.marketPoints?.length ? [{ id: 'market', label: 'Why it matters' }] : []),
  ...(project.challenges.length ? [{ id: 'engineering', label: 'Engineering' }] : []),
  ...(project.slug === 'tongalang' ? [{ id: 'pipeline', label: 'Pipeline' }] : []),
  ...(project.productionPath?.length ? [{ id: 'production', label: 'To production' }] : []),
  { id: 'reflection', label: 'Reflection' },
];

const num = (id: string) => String(sections.findIndex((section) => section.id === id) + 1).padStart(2, '0');
---
<BaseLayout title={`${project.name} Case Study | Leo Mabuku`} description={project.shortDescription} schema={projectSchema}>
  <article class="case-study" data-project-slug={project.slug}>
    <header class="case-hero section-shell">
      <a class="back-link" href="/work/"><i class="ph ph-arrow-left" aria-hidden="true"></i> Back to work</a>
      <div class="case-title" data-motion>
        <p class="eyebrow">{project.type}</p>
        <h1 transition:name={`project-title-${project.slug}`}>{project.name}</h1>
        <p>{project.shortDescription}</p>
        {project.slug === 'tongalang' && <a class="button case-playground-link" href="/playground/">Run TongaLang in your browser ↗</a>}
        <div class="case-badges">
          <span>{project.status}</span>
          {hackathon && <a class="case-badge-accent" href="/about/#hackathons">{hackathon.resultShort} · {hackathon.name} {hackathon.edition}</a>}
          <span>{project.year}</span>
          <span>{repositories.length > 1 ? `${repositories.length} project links` : project.repositoryVisibility === 'public' ? 'Public repository' : 'Private source'}</span>
        </div>
      </div>
      {project.cover ? (
        <figure class="case-cover" data-motion transition:name={`project-visual-${project.slug}`}>
          <img src={project.cover} alt={project.coverAlt} />
          <span class="case-cover-scan" aria-hidden="true"></span>
          <figcaption>{project.media?.length ? 'From the current build.' : 'Project cover.'}</figcaption>
        </figure>
      ) : (
        <div class="case-cover case-cover--system" aria-label={`${project.name} system overview`} data-motion transition:name={`project-visual-${project.slug}`}>
          <span>{project.category[0]}</span>
          <strong>{project.name}</strong>
          <small>{project.technologies.join(' · ')}</small>
        </div>
      )}
      <dl class="case-facts" data-motion>
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Status</dt><dd>{project.status}</dd></div>
        <div><dt>Year</dt><dd>{project.year}</dd></div>
        <div><dt>Stack</dt><dd>{project.technologies.join(' · ')}</dd></div>
      </dl>
      {project.updatedOn && (
        <div class="project-update" data-motion>
          <p class="eyebrow">Latest project update</p>
          <div><time datetime={project.updatedOn}>{formattedUpdatedOn}</time><p>{project.updateSummary}</p></div>
        </div>
      )}
    </header>

    <nav class="case-progress" aria-label="Case study chapters" data-motion>
      {sections.map((section, index) => (
        <a href={`#${section.id}`} data-case-link={section.id}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <span class="case-progress-label">{section.label}</span>
        </a>
      ))}
    </nav>

    <section id="context" class="case-section section-shell" data-case-section data-motion>
      <div><p class="eyebrow">{num('context')} · Context</p><h2>The problem</h2></div>
      <div>
        <p class="case-lede">{project.problem}</p>
        <h3>The response</h3>
        <p>{project.solution}</p>
      </div>
    </section>

    <section id="contribution" class="case-section section-shell" data-case-section data-motion>
      <div><p class="eyebrow">{num('contribution')} · Contribution</p><h2>What I built</h2></div>
      <ul class="numbered-list" data-motion-stagger>
        {project.contributions.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
        ))}
      </ul>
    </section>

    <section id="capabilities" class="case-features section-shell" data-case-section data-motion>
      <div class="section-heading">
        <p class="eyebrow">{num('capabilities')} · What it does</p>
        <h2>What it does<br/><em>today.</em></h2>
      </div>
      <div class="feature-grid" data-motion-stagger>
        {project.features.map((feature) => (
          <div><i class="ph ph-check" aria-hidden="true"></i><span>{feature}</span></div>
        ))}
      </div>
    </section>

    {project.audience?.length && (
      <section id="audience" class="case-section section-shell" data-case-section data-motion>
        <div><p class="eyebrow">{num('audience')} · Who it is for</p><h2>The people<br/><em>it serves.</em></h2></div>
        <div>
          <div class="audience-grid" data-motion-stagger>
            {project.audience.map((item) => (
              <article><h3>{item.who}</h3><p>{item.why}</p></article>
            ))}
          </div>
          {project.limitations?.length && (
            <div class="limitations">
              <p class="eyebrow">Current limits, stated plainly</p>
              {project.limitations.map((item) => <p>{item}</p>)}
            </div>
          )}
        </div>
      </section>
    )}

    {project.media && project.media.length > 0 && (
      <section id="evidence" class="project-media section-shell" data-case-section data-motion>
        <div class="section-heading">
          <p class="eyebrow">{num('evidence')} · Screens</p>
          <h2>See it<br/><em>working.</em></h2>
          <p>Screenshots and recordings from the real build, with the notes that belong to them.</p>
        </div>
        <div class="media-grid" data-motion-stagger>
          {project.media.map((item) => (
            <figure class:list={['media-card', item.layout && `media-card--${item.layout}`, item.type === 'video' && 'media-card--video']}>
              {item.type === 'video' ? (
                <video controls preload="metadata" poster={item.poster} aria-label={item.alt}>
                  <source src={item.src} type="video/mp4" />Your browser does not support embedded video. <a href={item.src}>Download the walkthrough</a>.
                </video>
              ) : (
                <a class="photo-open" href={item.src} data-lightbox-item data-caption={item.caption}>
                  <img src={item.src} alt={item.alt} loading="lazy" />
                </a>
              )}
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {project.marketPoints?.length && (
      <section id="market" class="case-section section-shell" data-case-section data-motion>
        <div><p class="eyebrow">{num('market')} · Why it matters</p><h2>A market measured in<br/><em>money, not litres.</em></h2></div>
        <div>
          <ul class="market-list" data-motion-stagger>
            {project.marketPoints.map((point) => <li><span>{point}</span></li>)}
          </ul>
        </div>
      </section>
    )}

    {project.challenges.length > 0 && (
      <section id="engineering" class="case-section section-shell" data-case-section data-motion>
        <div><p class="eyebrow">{num('engineering')} · Engineering</p><h2>Hard parts,<br/><em>clear decisions.</em></h2></div>
        <div class="challenge-list" data-motion-stagger>
          {project.challenges.map((challenge) => (
            <article><h3>{challenge.title}</h3><p>{challenge.description}</p></article>
          ))}
        </div>
      </section>
    )}

    {project.slug === 'tongalang' && (
      <section id="pipeline" class="architecture section-shell" data-case-section data-motion>
        <div class="section-heading"><p class="eyebrow">Execution pipeline</p><h2>From source to<br/><em>feedback.</em></h2></div>
        <ol aria-label="TongaLang interpreter pipeline">
          <li>Source <small>.tg program</small></li>
          <li>Lexer <small>tokens</small></li>
          <li>Parser <small>grammar</small></li>
          <li>AST <small>structure</small></li>
          <li>Interpreter <small>runtime</small></li>
          <li>Output <small>or guided problem</small></li>
        </ol>
      </section>
    )}

    {project.productionPath?.length && (
      <section id="production" class="case-section section-shell" data-case-section data-motion>
        <div><p class="eyebrow">{num('production')} · Path to production</p><h2>What it takes<br/><em>to run for real.</em></h2></div>
        <ul class="numbered-list" data-motion-stagger>
          {project.productionPath.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
          ))}
        </ul>
      </section>
    )}

    <section id="reflection" class="case-section section-shell" data-case-section data-motion>
      <div><p class="eyebrow">{num('reflection')} · Reflection</p><h2>What I learned</h2></div>
      <div>
        <div class="tag-list tag-list--large" data-motion-stagger>
          {project.lessons.map((lesson) => <span>{lesson}</span>)}
        </div>
        {project.plannedFeatures.length > 0 && (
          <div class="planned">
            <h3>Planned or still in development</h3>
            <ul>{project.plannedFeatures.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
        <div class="evidence-note">
          <p class="evidence-note-label"><i class="ph ph-seal-check" aria-hidden="true"></i>Where it stands</p>
          <p>{project.evidence}</p>
        </div>
        {hackathon && (
          <p class="hackathon-reference">
            <i class="ph ph-trophy" aria-hidden="true"></i>
            <span>Built at the <a href="/about/#hackathons">{hackathon.name} · {hackathon.edition}</a>, {hackathon.period} in {hackathon.location}. Result: {hackathon.result.toLowerCase()}. {hackathon.acknowledgement}</span>
          </p>
        )}
      </div>
    </section>

    <section class="case-links section-shell" data-motion>
      <div>
        <p class="eyebrow">The code</p>
        <h2>{project.repositoryVisibility === 'public' ? 'Read the source.' : 'The source stays private.'}</h2>
      </div>
      <div class="actions">
        {repositories.length ? repositories.map((repository, index) => (
          <a class={index === 0 ? 'button' : 'text-link'} href={repository.url} target="_blank" rel="noreferrer">
            {repository.label} <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        )) : (
          <span class="private-access"><i class="ph ph-lock-key" aria-hidden="true"></i>Private repository · details shared without exposing source</span>
        )}
        {project.liveDemo && <a class="text-link" href={project.liveDemo} target="_blank" rel="noreferrer">{project.slug === 'cbu-find' ? 'Open web app (account required)' : 'View live project'} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>}
      </div>
    </section>

    <nav class="case-nav section-shell" aria-label="Other case studies">
      <a href={`/work/${previous.slug}/`}><small>Previous project</small><strong><i class="ph ph-arrow-left" aria-hidden="true"></i>{previous.name}</strong></a>
      <a href={`/work/${next.slug}/`}><small>Next project</small><strong>{next.name}<i class="ph ph-arrow-right" aria-hidden="true"></i></strong></a>
    </nav>
  </article>
  <AvailabilityBanner />
</BaseLayout>
